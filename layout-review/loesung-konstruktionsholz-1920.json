[{"tag":"H1","text":"Konstruktionsholz: ein Tragwerk, das Kohlenstoff speichert","lines":2,"width":1133,"font":"43.5938px"},{"tag":"H2","text":"DIE TECHNOLOGIE","lines":1,"width":607,"font":"11.8875px"},{"tag":"H3","text":"SO WIRD ES GEBAUT","lines":1,"width":607,"font":"11.8875px"},{"tag":"H3","text":"Holz, technisch veredelt, um Gebäude zu tragen","lines":2,"width":560,"font":"35.6625px"},{"tag":"H4","text":"Vom Wald zum fertigen Tragwerk","lines":1,"width":560,"font":"35.6625px"},{"tag":"H3","text":"PROJEKTTYPEN","lines":1,"width":607,"font":"11.8875px"},{"tag":"H4","text":"Von Schulen bis Flughäfen: Infrastruktur dient sehr unterschiedlichen Zwecken","lines":2,"width":678,"font":"35.6625px"},{"tag":"H2","text":"VORTEILE","lines":1,"width":607,"font":"11.8875px"},{"tag":"H3","text":"Was Konstruktionsholz einem Projekt bietet","lines":2,"width":678,"font":"35.6625px"},{"tag":"H4","text":"01 Schnellere, besser planbare Montage","lines":3,"width":567,"font":"16px"},{"tag":"H4","text":"02 Weniger Kohlenstoff und ein Kohlenstoffspeicher","lines":4,"width":567,"font":"16px"},{"tag":"H4","text":"03 Ein leichteres Tragwerk","lines":3,"width":567,"font":"16px"},{"tag":"H4","text":"04 Widerstandsfähig bei Erdbeben","lines":3,"width":567,"font":"16px"},{"tag":"H4","text":"05 Qualität aus der Werkhalle","lines":3,"width":567,"font":"16px"},{"tag":"H4","text":"06 Eine sauberere, leisere Baustelle","lines":3,"width":567,"font":"16px"},{"tag":"H4","text":"07 Angenehme, ruhigere Innenräume","lines":3,"width":567,"font":"16px"},{"tag":"H4","text":"08 Im großen Maßstab bewährt","lines":3,"width":567,"font":"16px"},{"tag":"H4","text":"Schnellere, besser planbare Montage","lines":1,"width":483,"font":"28.53px"},{"tag":"H3","text":"IN ZAHLEN","lines":1,"width":76,"font":"11.8875px"},{"tag":"H4","text":"Vorteile, gestützt durch veröffentlichte Fakten","lines":2,"width":588,"font":"35.6625px"},{"tag":"H3","text":"VERGLEICH","lines":1,"width":76,"font":"11.8875px"},{"tag":"H4","text":"Leichter und CO₂-ärmer als Beton, trocken in Reihenfolge gebaut.","lines":2,"width":704,"font":"32px"},{"tag":"H3","text":"KONTAKT","lines":1,"width":607,"font":"11.8875px"},{"tag":"H4","text":"Erwägen Sie Konstruktionsholz für ein Projekt? Wir melden uns mit einer ersten Skizze","lines":2,"width":1191,"font":"35.6625px"}]