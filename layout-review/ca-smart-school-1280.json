[{"tag":"H1","text":"Eine klimaresiliente Holzschule für Zentralasien – als übertragbares Konzept","lines":2,"width":788,"font":"34px"},{"tag":"H3","text":"DIE HERAUSFORDERUNG","lines":1,"width":156,"font":"11px"},{"tag":"H4","text":"Zu wenige Schulen, und die vorhandenen sind überfüllt und veraltet","lines":3,"width":429,"font":"26px"},{"tag":"H2","text":"SCHULKONZEPT","lines":1,"width":394,"font":"11px"},{"tag":"H3","text":"Eine Holzschule für 750 Schüler rund um einen Innenhof","lines":2,"width":390,"font":"26px"},{"tag":"H3","text":"WARUM ES FUNKTIONIERT","lines":1,"width":394,"font":"11px"},{"tag":"H4","text":"Warum Massivholz zu dieser Schule passt","lines":2,"width":494,"font":"26px"},{"tag":"H2","text":"ZUSAMMENARBEIT MIT IM HOLZ","lines":1,"width":394,"font":"11px"},{"tag":"H3","text":"Die Partner zusammenbringen, die dieses Konzept braucht","lines":2,"width":350,"font":"26px"},{"tag":"H4","text":"Behörden & Kommunen","lines":1,"width":238,"font":"17px"},{"tag":"H4","text":"Technologieanbieter","lines":1,"width":238,"font":"17px"},{"tag":"H4","text":"Internationale Organisationen","lines":1,"width":238,"font":"17px"},{"tag":"H4","text":"Ingenieurwesen & Planung","lines":1,"width":238,"font":"17px"},{"tag":"H4","text":"Finanzinstitute","lines":1,"width":238,"font":"17px"},{"tag":"H4","text":"Gemeinschaften & Nutzer","lines":1,"width":238,"font":"17px"},{"tag":"H3","text":"VOLLSTÄNDIGES KONZEPT","lines":1,"width":394,"font":"11px"},{"tag":"H4","text":"Möchten Sie das vollständige Konzept? Wir senden es Ihnen gern zu","lines":2,"width":772,"font":"26px"}]