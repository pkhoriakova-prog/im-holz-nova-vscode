                        "children": []
                      },
                      {
                        "id": 104,
                        "data": {
                          "type": "OxygenElements\\Text",
                          "properties": {
                            "content": {
                              "content": {
                                "text": "VietnamWood is the international exhibition for the wood-processing industry in Ho Chi Minh City. The 2025 edition ran from 19 to 22 November at the Saigon Exhibition and Convention Center, with more than 320 exhibitors from 28 countries and regions expected."
                              }
                            },
                            "settings": {
                              "advanced": {
                                "tag": "p"
                              }
                            },
                            "meta": {
                              "classes": [
                                "8e275127-b408-4268-85e9-0a2ecbe546b9",
                                "9e774b40-c018-4737-8691-108f45347b5d"
                              ]
                            }
                          }
                        },
                        "children": []
                      },
                      {
                        "id": 105,
                        "data": {
                          "type": "OxygenElements\\Text",
                          "properties": {
                            "content": {
                              "content": {
                                "text": "Our booth gave us a place to talk about certified timber with buyers and partners from Vietnam and the wider region."
