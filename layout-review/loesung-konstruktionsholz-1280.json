[{"tag":"H1","text":"Konstruktionsholz: ein Tragwerk, das Kohlenstoff speichert","lines":2,"width":788,"font":"34px"},{"tag":"H2","text":"DIE TECHNOLOGIE","lines":1,"width":394,"font":"11px"},{"tag":"H3","text":"SO WIRD ES GEBAUT","lines":1,"width":394,"font":"11px"},{"tag":"H3","text":"Holz, technisch veredelt, um Gebäude zu tragen","lines":2,"width":362,"font":"26px"},{"tag":"H4","text":"Vom Wald zum fertigen Tragwerk","lines":2,"width":362,"font":"26px"},{"tag":"H3","text":"PROJEKTTYPEN","lines":1,"width":394,"font":"11px"},{"tag":"H4","text":"Von Schulen bis Flughäfen: Infrastruktur dient sehr unterschiedlichen Zwecken","lines":2,"width":494,"font":"26px"},{"tag":"H2","text":"VORTEILE","lines":1,"width":394,"font":"11px"},{"tag":"H3","text":"Was Konstruktionsholz einem Projekt bietet","lines":2,"width":494,"font":"26px"},{"tag":"H4","text":"01 Schnellere, besser planbare Montage","lines":4,"width":367,"font":"16px"},{"tag":"H4","text":"02 Weniger Kohlenstoff und ein Kohlenstoffspeicher","lines":4,"width":367,"font":"16px"},{"tag":"H4","text":"03 Ein leichteres Tragwerk","lines":3,"width":367,"font":"16px"},{"tag":"H4","text":"04 Widerstandsfähig bei Erdbeben","lines":3,"width":367,"font":"16px"},{"tag":"H4","text":"05 Qualität aus der Werkhalle","lines":3,"width":367,"font":"16px"},{"tag":"H4","text":"06 Eine sauberere, leisere Baustelle","lines":3,"width":367,"font":"16px"},{"tag":"H4","text":"07 Angenehme, ruhigere Innenräume","lines":3,"width":367,"font":"16px"},{"tag":"H4","text":"08 Im großen Maßstab bewährt","lines":3,"width":367,"font":"16px"},{"tag":"H4","text":"Schnellere, besser planbare Montage","lines":2,"width":312,"font":"21px"},{"tag":"H3","text":"IN ZAHLEN","lines":1,"width":70,"font":"11px"},{"tag":"H4","text":"Vorteile, gestützt durch veröffentlichte Fakten","lines":2,"width":429,"font":"26px"},{"tag":"H3","text":"VERGLEICH","lines":1,"width":71,"font":"11px"},{"tag":"H4","text":"Leichter und CO₂-ärmer als Beton, trocken in Reihenfolge gebaut.","lines":2,"width":486,"font":"22.085px"},{"tag":"H3","text":"KONTAKT","lines":1,"width":394,"font":"11px"},{"tag":"H4","text":"Erwägen Sie Konstruktionsholz für ein Projekt? Wir melden uns mit einer ersten Skizze","lines":2,"width":772,"font":"26px"}]